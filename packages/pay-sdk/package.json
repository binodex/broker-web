{
  "name": "@binopartner/pay-sdk",
  "version": "0.3.2",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binodex/broker-web.git",
    "directory": "packages/pay-sdk"
  },
  "homepage": "https://github.com/binodex/broker-web/tree/main/packages/pay-sdk#readme",
  "description": "Binodex deposits and withdrawals for broker sites: a hardened iframe widget, a headless core and React elements.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "core": [
        "./dist/core/index.d.ts"
      ],
      "elements": [
        "./dist/elements/index.d.ts"
      ],
      "ui": [
        "./dist/ui/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js",
      "default": "./dist/elements/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./elements.css": "./dist/elements.css",
    "./ui.css": "./dist/ui.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.18",
    "jsdom": "^27.4.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
