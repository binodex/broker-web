{
  "name": "@binopartner/pay-sdk",
  "version": "0.1.1",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binodex/broker-web.git",
    "directory": "packages/pay-sdk"
  },
  "homepage": "https://github.com/binodex/broker-web/tree/main/packages/pay-sdk#readme",
  "description": "Embed the Binodex deposit and withdrawal widget: a root component, composable parts and a hardened iframe channel.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "jsdom": "^27.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
